# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional. Setup for Claude 3.5 Sonnet Vision translation support.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# OPENAI_API_KEY: Optional. GPT-4o vision fallback and Whisper speech-to-text.
# Leave empty if unused (only the two placeholders above are ignored by the server).
OPENAI_API_KEY=""

# Optional model overrides (defaults: gemini-2.0-flash, claude-3-5-sonnet-latest, gpt-4o).
# GEMINI_MODEL=""
# CLAUDE_MODEL=""
# OPENAI_MODEL=""

# AfricasTalking: Optional. Emergency SOS SMS relay. Username defaults to "sandbox".
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
